########################################################################################################################

# mcu: STM32G030K8                                                                                                     #
# clk: 64 MHz                                                                                                          #
#xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx#



# Initial NVIC config

NVIC.HardFault_IRQn=true\:0\:0\:false\:false\:false\:true
NVIC.NonMaskableInt_IRQn=true\:0\:0\:false\:false\:true\:false
NVIC.PendSV_IRQn=true\:0\:0\:false\:false\:true\:false
NVIC.SVC_IRQn=true\:0\:0\:false\:false\:true\:false
NVIC.SysTick_IRQn=true\:3\:0\:true\:false\:false\:true



Mcu.Family=STM32G0
Mcu.Package=LQFP32
Mcu.Name=STM32G030K(6-8)Tx
Mcu.UserName=STM32G030K8Tx
ProjectManager.DeviceId=STM32G030K8Tx

